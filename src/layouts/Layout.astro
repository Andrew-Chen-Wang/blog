---
import { getLocale } from "astro-i18n-aut";
import { ViewTransitions } from "astro:transitions";
import BaseHead from "@components/BaseHead.astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SPORATIC_PAGES } from "@src/consts";
import { getUrlWithoutLocale } from "astro-i18n-aut";

const locale = getLocale(Astro.url);

// replaced dynamically
const buildDate = new Date(__DATE__);

type Props = {
	title?: string;
	description?: string;
	image?: string;
};

const { image, title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props as Props;

// Posts mark their own content for search; sporatic pages are indexed whole.
const path = getUrlWithoutLocale(Astro.url).replace(/\/$/, "");
const isSporatic = SPORATIC_PAGES.some((page) => path === page.href || path.startsWith(page.href + "/"));
---

<html lang={locale}>
	<head>
		<BaseHead title={title} description={description} image={image} />
		{/* Comment the line below if you want to remove client side routing */}
		<ViewTransitions />
	</head>

	<body>
		<Navbar />
		<main data-pagefind-body={isSporatic ? "" : undefined}>
			<slot />
		</main>
		<Footer {buildDate} />
	</body>
</html>
