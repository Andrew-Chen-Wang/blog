---
// Site search powered by Pagefind. astro-pagefind generates the index during
// `astro build`; `astro dev` serves the index from the last build, so run
// `pnpm run build` to pick up new or edited pages.
//
// Typing `@tag` (e.g. `@politics`) filters results to that tag. A tag on its own
// lists every post with it.
---

<div class="flex items-center justify-center">
	<pagefind-modal-trigger placeholder="Search"></pagefind-modal-trigger>
	<pagefind-modal reset-on-close>
		<pagefind-modal-header>
			<pagefind-input placeholder="Search posts, or @tag to filter"></pagefind-input>
			<pagefind-filter-dropdown filter="tag" label="Tags"></pagefind-filter-dropdown>
		</pagefind-modal-header>
		<pagefind-modal-body>
			<pagefind-summary></pagefind-summary>
			<pagefind-results></pagefind-results>
		</pagefind-modal-body>
		<pagefind-modal-footer>
			<pagefind-keyboard-hints></pagefind-keyboard-hints>
		</pagefind-modal-footer>
	</pagefind-modal>
</div>

<script>
	import "@pagefind/component-ui";
	import "@pagefind/component-ui/css";
	import { getInstanceManager } from "@pagefind/component-ui";

	const TAG_FILTER = "tag";
	const TAG_PATTERN = /(^|\s)@(\S+)/g;

	type Filters = Record<string, unknown>;

	// Map `@politics` / `@pol` to the canonical "Politics" tag. Exact
	// (case-insensitive) matches win; otherwise use an unambiguous prefix match.
	function resolveTag(query: string, known: string[]): string | undefined {
		const lower = query.toLowerCase();
		const exact = known.find((tag) => tag.toLowerCase() === lower);
		if (exact) return exact;
		const prefixed = known.filter((tag) => tag.toLowerCase().startsWith(lower));
		return prefixed.length === 1 ? prefixed[0] : undefined;
	}

	// Patch the underlying Pagefind search so `@tag` tokens become tag filters.
	// Doing it at this level (rather than in the component instance) lets a lone
	// `@tag` with no other text still run a filter-only search.
	function patchInstance() {
		const instance = getInstanceManager().getInstance("default") as any;
		if (instance.__atTagsPatched__) return;
		instance.__atTagsPatched__ = true;
		const load = instance.__load__.bind(instance);
		instance.__load__ = async () => {
			await load();
			const pagefind = instance.__pagefind__;
			if (!pagefind || pagefind.__atTagsPatched__) return;
			pagefind.__atTagsPatched__ = true;
			const search = pagefind.search.bind(pagefind);
			pagefind.search = (term: string | null, options: { filters?: Filters } = {}) => {
				if (!term || !term.includes("@")) return search(term, options);

				const known = Object.keys(instance.totalFilters?.[TAG_FILTER] ?? {});
				const atTags: string[] = [];
				const text = term
					.replace(TAG_PATTERN, (match: string, lead: string, query: string) => {
						const tag = resolveTag(query, known);
						if (!tag) return match;
						atTags.push(tag);
						return lead;
					})
					.trim();
				if (!atTags.length) return search(text || term, options);

				// Combine with tags picked from the dropdown; a result must have every tag.
				const picked = options.filters?.[TAG_FILTER];
				const tags = [...new Set([...(Array.isArray(picked) ? picked : []), ...atTags])];
				return search(text || null, { ...options, filters: { ...options.filters, [TAG_FILTER]: tags } });
			};
		};
	}
	patchInstance();

	// View transitions replace the navbar, but Pagefind components never unregister
	// from their instance, so the old modal stays wired to the trigger. Start each
	// page with a fresh instance for the new components to attach to.
	document.addEventListener("astro:before-swap", () => getInstanceManager().removeInstance("default"));
	document.addEventListener("astro:after-swap", patchInstance);

	// Pagefind caps the tag list at a fixed 280px. Instead, let it fill the space from the
	// menu down to the bottom of the viewport (the modal stops clipping it while it's open).
	const FILTER_MENU_MARGIN = 16;
	function fitFilterMenu(menu: HTMLElement) {
		if (menu.hidden) return;
		const dropdown = menu.closest("pagefind-filter-dropdown") as HTMLElement | null;
		// The menu's padding and border sit around the list
		const chrome = menu.offsetHeight - (menu.querySelector(".pf-dropdown-options") as HTMLElement).offsetHeight;
		const available = window.innerHeight - menu.getBoundingClientRect().top - chrome - FILTER_MENU_MARGIN;
		dropdown?.style.setProperty("--pf-dropdown-max-height", `${Math.max(available, 120)}px`);
	}
	const openFilterMenus = () => document.querySelectorAll<HTMLElement>(".pf-dropdown-menu:not([hidden])");
	// Observe the whole document so this survives view transitions swapping the navbar
	new MutationObserver((mutations) => {
		for (const { target } of mutations) {
			if (target instanceof HTMLElement && target.classList.contains("pf-dropdown-menu")) fitFilterMenu(target);
		}
	}).observe(document.documentElement, { subtree: true, attributes: true, attributeFilter: ["hidden"] });
	window.addEventListener("resize", () => openFilterMenus().forEach(fitFilterMenu));

	// Match Pagefind's palette to the site's class-based dark mode.
	const root = document.documentElement;
	const syncTheme = () => root.setAttribute("data-pf-theme", root.classList.contains("dark") ? "dark" : "light");
	syncTheme();
	new MutationObserver(syncTheme).observe(root, { attributes: true, attributeFilter: ["class"] });
</script>

<style is:global>
	/* Pagefind caps both the filter menu and the options list inside it at the same
	   max-height, so both scroll. Keep only the inner list scrolling, since that's the
	   element Pagefind scrolls during keyboard navigation. Its height is set in the
	   script above to fill the modal. */
	:is(*, #\#):is(*, #\#):is(*, #\#) pagefind-filter-dropdown .pf-dropdown-menu {
		max-height: none;
		overflow: hidden;
	}

	/* The modal clips its contents, which cut the open tag menu off at the modal's bottom
	   edge (only a couple of tags showed with an empty search). */
	:is(*, #\#):is(*, #\#):is(*, #\#) dialog.pf-modal:has(.pf-dropdown-menu:not([hidden])) {
		overflow: visible;
	}
</style>
