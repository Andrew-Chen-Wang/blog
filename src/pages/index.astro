---
// import translations
import translations from "@utils/t.ts";
import { localizePath } from "@utils/t.ts";
import Layout from "@layouts/Layout.astro";
import Container from "@src/components/Container.astro";
import { SPORATIC_PAGES } from "@src/consts";

const t = translations(Astro.url);
const url = Astro.url;

const sections = [
	{ title: "Blog", href: "/blog", description: t.blog_card_description },
	{ title: "Short Thoughts", href: "/short-thoughts", description: t.short_thoughts_card_description },
	{ title: "Recipes", href: "/recipes", description: t.recipes_card_description },
];
---

<Layout>
	<Container class="pt-16">
		<p class="mb-6">
			<i>Why is post-encouragement discouragement futile?</i>
		</p>

		<span set:html={t.home_description} />

		<nav aria-label="Sections" class="mt-12 grid gap-4 sm:grid-cols-3">
			{
				sections.map((section) => (
					<a
						href={localizePath(section.href, url)}
						class="group block rounded-lg border border-stone-200 bg-white p-5 no-underline transition-colors duration-200 hover:border-primary-400 dark:border-stone-700 dark:bg-stone-900 dark:hover:border-primary-400">
						<h2 class="m-0 text-lg font-semibold group-hover:text-primary-600 dark:group-hover:text-primary-400">{section.title}</h2>
						<p class="m-0 mt-2 text-sm text-stone-600 dark:text-stone-400">{section.description}</p>
					</a>
				))
			}
		</nav>

		<section class="mt-12">
			<h2 class="m-0 text-lg font-semibold">Sporatic</h2>
			<p class="m-0 mt-1 text-sm text-stone-600 dark:text-stone-400">One-off pages that don't belong to a category.</p>
			<ul class="mt-3 list-none space-y-2 p-0">
				{
					SPORATIC_PAGES.map((page) => (
						<li class="m-0">
							<a href={localizePath(page.href, url)} class="underline decoration-stone-300 underline-offset-4 hover:decoration-primary-400 dark:decoration-stone-600">
								{page.title}
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</Container>
</Layout>
